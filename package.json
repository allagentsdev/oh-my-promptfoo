{
  "name": "oh-my-promptfoo",
  "version": "1.20.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests",
    "pack:check": "bun scripts/smoke-packed-package.ts",
    "e2e": "bun scripts/e2e.ts"
  },
  "overrides": {
    "get-uri@8.0.1": {
      "basic-ftp": "6.2.3"
    },
    "node-forge": "github:matthewscottconroy/forge#db05494352dd3c9a5a07c5270333dcc78866cad2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@github/copilot-sdk": "1.0.17",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@types/bun": "1.3.10",
    "@types/diff": "7.0.2",
    "@types/node": "22.19.15",
    "diff": "8.0.3",
    "ignore": "7.0.5",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "promptfoo": "0.124.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
