{
  "name": "promptfoo-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
