{
  "name": "oh-my-promptfoo",
  "version": "1.26.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "pack:check": "node --import tsx scripts/smoke-packed-package.ts",
    "e2e": "node --import tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@github/copilot-sdk": "1.0.22",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-consumer": "npm:@opentelemetry/api@1.10.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/node": "22.20.5",
    "diff": "9.0.0",
    "ignore": "7.0.12",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "promptfoo": "0.125.1",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
