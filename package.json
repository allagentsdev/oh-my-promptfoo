    "@opentelemetry/core": "2.6.0",
    "@opentelemetry/sdk-trace-node": "2.6.0",
    "@types/bun": "1.3.10",
    "@types/diff": "7.0.2",
    "@types/node": "22.19.15",
    "diff": "8.0.2",
    "ignore": "7.0.5",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "promptfoo": "0.122.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
